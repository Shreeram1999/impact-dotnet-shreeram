<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage settings for StudentApi.Tests. EF Core migrations are code
     GENERATED by `dotnet ef migrations add` and only run when the schema is
     migrated, so they're excluded from the line-coverage figure (the
     resulting schema is still exercised: SQLite tests build it from the same
     model). Everything hand-written is measured. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/Data/EfCodeFirst/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>ExcludeFromCodeCoverage,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
