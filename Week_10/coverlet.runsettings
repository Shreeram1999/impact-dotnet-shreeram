<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage settings shared by the Week 10 service test projects. EF Core
     migrations are generated code that only runs when a schema is migrated,
     so they are excluded and the 80% gate measures hand-written code.
     (Reporting's scaffolded classes stay IN the figure: its tests exercise
     them.) -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/Data/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>ExcludeFromCodeCoverage,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
