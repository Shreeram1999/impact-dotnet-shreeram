<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one piece every service shares: HOW to validate the portal's JWT
       (issuer, audience, signing key, claim names). Deliberately tiny - no
       domain types live here, so services stay independently deployable. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

</Project>
