{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "StudentPortal.Identity",
    "Audience": "StudentPortal"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "CorsPolicy": "SpaClient",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/identity" } ]
      },
      "academics": {
        "ClusterId": "academics",
        "AuthorizationPolicy": "default",
        "CorsPolicy": "SpaClient",
        "Match": { "Path": "/academics/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/academics" } ]
      },
      "reporting": {
        "ClusterId": "reporting",
        "AuthorizationPolicy": "default",
        "CorsPolicy": "SpaClient",
        "Match": { "Path": "/reporting/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/reporting" } ]
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5101/" } } },
      "academics": { "Destinations": { "d1": { "Address": "http://localhost:5102/" } } },
      "reporting": { "Destinations": { "d1": { "Address": "http://localhost:5103/" } } }
    }
  }
}
